{=== (F) Reactions ======================================================================================================================================

    {— (F1) Stoichiometric Reactions -------------------------------------------------------------------------------------------------------------

        {
            "@id": "#Reaction1",
            "@type": "ex:StoichiometricReaction",
            "schema:name": "Hydrogenation Reaction",
            "schema:description": "RDY + 4 H2 > RDEt",
            % catalyst also in here? if yes, then I'll add the solid catalyst phase as well
            "schema:comment": "Should I put in catalyst and solvent here as well? How do we include the solvent?",
            "ex:hasParticipant": 
                [      
                    {
                        "@id": "#Participant_R1_RDY"
                    },
                    {
                        "@id": "#Participant_R1_H2"
                    },
                    {
                        "@id": "#Participant_R1_RDEt"
                    }
                    
                ],
            "ex:describedByMechanism": 
                {
                    "@id": "#ReactionMechanism1"
                },
            "ex:occursBetweenPhases": 
                [
                    {
                        "@id": "#LiquidPhase"
                    },
                    % solid phase technically not, if we assume RDY is solved in the liquid phase
                    {
                        "@id": "#SolidPhase"
                    },
                    {
                        "@id": "#DispersedGasPhase"
                    }
                ],
        },


        {
            "@id": "#Reaction2",
            "@type": "ex:StoichiometricReaction",
            "schema:name": "Dimerisation 1",
            "schema:description": "RYE + RDEt > Dimer1",
            "schema:comment": "Should I put in catalyst and solvent here as well? How do we include the solvent?",
            "ex:hasParticipant": 
                [      
                    {
                        "@id": "#Participant_R2_RYE"
                    },
                    {
                        "@id": "#Participant_R2_RDEt"
                    },
                    {
                        "@id": "#Participant_R2_Dimer1"
                    }
                    
                ],
            "ex:describedByMechanism": 
                {
                    "@id": "#ReactionMechanism2"
                },
            % catalyst also in here? if yes, then I'll add the solid catalyst phase as well
            "ex:occurrsInPhase": 
                {
                    "@id": "#LiquidPhase"
                },
        },

        {
            "@id": "#Reaction3",
            "@type": "ex:StoichiometricReaction",
            "schema:name": "Dimerisation 2",
            "schema:description": "REA + RDEt > Dimer2",
            "schema:comment": "Should I put in catalyst and solvent here as well? How do we include the solvent?",
            "ex:hasParticipant": 
                [      
                    {
                        "@id": "#Participant_R3_REA"
                    },
                    {
                        "@id": "#Participant_R3_RDEt"
                    },
                    {
                        "@id": "#Participant_R3_Dimer2"
                    }
                    
                ],
            "ex:describedByMechanism": 
                {
                    "@id": "#ReactionMechanism3"
                },
            % catalyst also in here? if yes, then I'll add the solid catalyst phase as well
            "ex:occurrsInPhase": 
                {
                    "@id": "#LiquidPhase"
                },

            



        },

    — (F1) Stoichiometric Reactions — END ----------------------------------------------------------------------------------------------------------}


    {— (F2) Elementary Reactions ---------------------------------------------------------------------------------------------------------------



        {· · · (F2)  · · · · · · Elementary Reactions of Stoichiometric Reaction 1 · · ·

            {
                "@id": "#Reaction1_1",
                "@type": "ex:ElementaryReaction",
                "schema:name": "H2 + 2 cat(H) <-> 2 cat-H",
                "schema:description": "Adsorption and desorption of hydrogen on the catalyst surface",
                "ex:reversibility": "ex:Reversible",
                "ex:hasParticipant":
                    [      
                        {
                            "@id": "#Participant_R1_1_H2"
                        },
                        {
                            "@id": "#Participant_R1_1_cat(H)"
                        },
                        {
                            "@id": "#Participant_R1_1_cat-H"
                        }
                    ],
                "ex:occursBetweenPhases": 
                    [
                        {
                            "@id": "#DispersedGasPhase"
                        },
                        {
                            "@id": "#CatalystPhase"
                        }
                    ],
                    
                
            },

            {
                "@id": "#Reaction1_2",
                "@type": "ex:ElementaryReaction",
                "schema:name": "RDY + cat-H > cat-RYE",
                "description": "RDY reacts with one adsorbed hydrogen on the catalyst surface to form intermediate state",
                "ex:reversibility": "ex:Irreversible",
                "ex:hasParticipant":
                    [      
                        {
                            "@id": "#Participant_R1_2_RDY"
                        },
                        {
                            "@id": "#Participant_R1_2_cat-H"
                        },
                        {
                            "@id": "#Participant_R1_2_cat-RYE"
                        }
                    ],
                "ex:occursBetweenPhases": 
                    [
                        {
                            "@id": "#LiquidPhase"
                        },
                        {
                            "@id": "#CatalystPhase"
                        }
                    ],
                
            },

            {
                "@id": "#Reaction1_3",
                "@type": "ex:ElementaryReaction",
                "schema:name": "cat-RYE+ cat-H > RYE + 2 cat(H)",
                "description": "cat-RYE intermediate reacts with one adsorbed hydrogen on the catalyst surface to form RYE, desorbs immediately",
                "ex:reversibility": "ex:Irreversible",
                "ex:hasParticipant":
                    [      
                        {
                            "@id": "#Participant_R1_3_cat-RYE"
                        },
                        {
                            "@id": "#Participant_R1_3_cat-H"
                        },
                        {
                            "@id": "#Participant_R1_3_RYE"
                        },
                        {
                            "@id": "#Participant_R1_3_cat(H)"
                        }
                    ],
                "ex:occursBetweenPhases": 
                    [
                        {
                            "@id": "#LiquidPhase"
                        },
                        {
                            "@id": "#CatalystPhase"
                        }
                    ],
                
            },


            {
                "@id": "#Reaction1_4",
                "@type": "ex:ElementaryReaction",
                "schema:name": "RYE + cat-H > cat-RYA",
                "description": "RYE reacts with one adsorbed hydrogen on the catalyst surface to form intermediate state",
                "ex:reversibility": "ex:Irreversible",
                "ex:hasParticipant":
                    [      
                        {
                            "@id": "#Participant_R1_4_RYE"
                        },
                        {
                            "@id": "#Participant_R1_4_cat-H"
                        },
                        {
                            "@id": "#Participant_R1_4_cat-RYA"
                        }
                    ],
                "ex:occursBetweenPhases": 
                    [
                        {
                            "@id": "#LiquidPhase"
                        },
                        {
                            "@id": "#CatalystPhase"
                        }
                    ],
                
            },


            {
                "@id": "#Reaction1_5",
                "@type": "ex:ElementaryReaction",
                "schema:name": "cat-RYA+ cat-H > RYA + 2 cat(H)",
                "description": "cat-RYE intermediate reacts with one adsorbed hydrogen on the catalyst surface to form RYA, desorbs immediately",
                "ex:reversibility": "ex:Irreversible",
                "ex:hasParticipant":
                    [      
                        {
                            "@id": "#Participant_R1_5_cat-RYA"
                        },
                        {
                            "@id": "#Participant_R1_5_cat-H"
                        },
                        {
                            "@id": "#Participant_R1_5_RYA"
                        },
                        {
                            "@id": "#Participant_R1_5_cat(H)"
                        }
                    ],
                "ex:occursBetweenPhases": 
                    [
                        {
                            "@id": "#LiquidPhase"
                        },
                        {
