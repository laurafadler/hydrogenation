        {++++++ Reactor General ++++++

            {
                "@id": "#Reactor",
                "@type": "ontolab:Reactor",
                "schema:name": "Reactor",
                "schema:description": "The whole reactor with its parts: stirrer, jacket, sparger (should we add reactor vessel seperately?)",
                "ex:hasPart": 
                    [
                        {
                            "@id": "#Vessel"
                        },
                        {
                            "@id": "#Jacket"
                        },
                        {
                            "@id": "#Sparger"
                        },
                        {
                            "@id": "#Stirrer"
                        },
                        
                        {
                            "@id": "#TemperatureSensor"
                        },
                        {
                            "@id": "#PressureSensor"
                        },
                        {
                            "@id": "#MFM"
                        }
                    ],
                "ex:hasContext": 
                    [
                        {
                            "@id": "#ReactorInformation"
                        },
                        {
                            "@id": "#ReactorEnergy"
                        },
                        {
                            "@id": "#ReactorTime"
                        },
                        {
                            "@id": "#ReactorSpace"
                        },
                        {
                            "@id": "#ReactorStructure"
                        },
                        {
                            "@id": "#ReactorSubstance"
                        }
                    ],
                "ex:hasDigitalObjectID": 
                    {
