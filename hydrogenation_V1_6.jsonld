                    [
                        {
                            "@id": "#TemperatureSensor_Exp1"
                        },
                        {
                            "@id": "#TemperatureSensor_Exp2"
                        },
                        {
                            "@id": "#TemperatureSensor_Exp3"
                        },
                        {
                            "@id": "#TemperatureSensor_Exp4"
                        },
                        {
                            "@id": "#TemperatureSensor_Exp5"
                        },
                        {
                            "@id": "#TemperatureSensor_Exp6"
                        },
                        {
                            "@id": "#TemperatureSensor_Exp7"
                        },
                        {
                            "@id": "#TemperatureSensor_Exp8"
                        },
                        {
                            "@id": "#TemperatureSensor_Exp9"
                        }
                    ]
            }

