            {
                "@id": "#TemperatureSensor",
                "@type": "sosa:Sensor",

                "schema:name": "Temperature Sensor",
                "schema:description": "Sensor for measuring the temperature of the reactor",
                "ex:hasContext":
                    [
                        {
                            "@id": "#TemperatureSensor_Information"
