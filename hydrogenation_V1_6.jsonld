                        }
                    ],

                "ex:hasDigitalObjectID":
                    {
                        "@id": "#DigitalObjectID_TemperatureSensor"
                    },
                % vielleicht reicht das ja als Plan für die general entity und wir müssen nicht 9 separate procedures erstellen, oder wir können es sogar in der device library hinterlegen
                "sosa:implements":
                    {
                        % bis jetzt haben wir noch keine Procedures
                        "@id": "#TemperatureObservingProcedure"
                    },
                % muss evtl nochmal angepasst werden wenn wir das Flowsheet hinterlegen
                "ex:location":
                    {
                        "@id": "#Reactor"
                    },

                "sosa:madeObservation":
                    {
                        "@id": "#TemperatureMeasurementTask"
                    },

                "sosa:observes":
                    [
                        {
                            "@id": "#RecordedTemperature_Reactor"
                        }
                    ],
